# Copy this file to .env and fill in values. Never commit .env.
# On a hosting platform, set the same names as environment variables instead.

# Threat intelligence enrichment: mock (offline, default), abuseipdb (live) or off.
TRIAGEDESK_ENRICHMENT_MODE=mock
# Required only when TRIAGEDESK_ENRICHMENT_MODE=abuseipdb. Free key: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Optional language model for incident summaries, through any OpenAI-compatible endpoint.
# Leave these empty to use the offline template summaries.
# Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
# Check the provider's documentation for current model names and free-tier limits.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Input limits and the time zone assumed for syslog lines that carry no offset.
TRIAGEDESK_MAX_UPLOAD_MB=10
TRIAGEDESK_MAX_LINES_PER_FILE=200000
TRIAGEDESK_LOG_TIMEZONE=UTC
